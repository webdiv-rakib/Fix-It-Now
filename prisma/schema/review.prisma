model Review {
    reviewId     String            @id @default(uuid())
    bookingId    String            @unique
    customerId   String
    technicianId String
    rating       Int
    comment      String?
    createdAt    DateTime          @default(now())
    updatedAt    DateTime          @updatedAt
    booking      Booking           @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
    customer     User              @relation("CustomerReviews", fields: [customerId], references: [userId], onDelete: Cascade)
    technician   TechnicianProfile @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

    @@map("reviews")
}
