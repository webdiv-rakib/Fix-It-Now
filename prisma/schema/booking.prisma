model Booking {
    bookingId      String            @id @default(uuid())
    customerId     String
    serviceId      String
    technicianId   String
    scheduleDate   DateTime
    status         BookingStatus     @default(PENDING)
    totalAmount    Float
    serviceAddress String
    notes          String?
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt
    //Relations
    customer       User              @relation("CustomerBookings", fields: [customerId], references: [userId], onDelete: Cascade)
    service        Service           @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
    technician     TechnicianProfile @relation(fields: [technicianId], references: [technicianId], onDelete: Cascade)

    @@map("bookings")
}
